# config.env - settings for the SWA -> Azure federation lab. Copy to config.env and edit the "EDIT" section.
#   cp config.env.example config.env && chmod 600 config.env
# config.env is git-ignored. Every script sources it after cd to this directory.

# ===== EDIT: where the SWA lab runs (it provides the agents / workload containers) ===========
LAB_DIR="$HOME/swa-azure-lab"          # clone of github.com/nirmal-dhanaraj/swa-azure-lab, already deployed (9/9 PASS)

# ===== EDIT: Azure =========================================================================
AZ_SUBSCRIPTION=""                     # subscription id or name; empty = current `az account show`
AZ_LOCATION="australiaeast"            # region for the resource group, identities and Key Vault
AZ_RG="rg-swa-federation"              # resource group created by 10-azure-setup.sh (deleted by 99-cleanup.sh)
KV_NAME="kv-swa-<unique>"              # Key Vault name: 3-24 chars, letters/digits/hyphens, GLOBALLY unique

# ===== Optional ============================================================================
ENVS="prod dev"                        # environments of the SWA lab to federate
AZ_AUDIENCE="api://AzureADTokenExchange"   # audience Entra expects in the SWA JWT-SVID (default for Entra federation)
AZ_SCOPE="https://vault.azure.net/.default" # Azure resource the workload asks a token for (Key Vault)
AZ_ROLE="Key Vault Secrets User"       # role the identity gets, scoped to ITS OWN secret only
AZ_LOGIN_HOST="https://login.microsoftonline.com"
